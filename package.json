{
  "name": "healthlab",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:unit": "vitest --run",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "api:types": "python ../HealthLab/manage.py spectacular --file src/api/generated/schema.yaml && openapi-typescript src/api/generated/schema.yaml -o src/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/vue": "^9.0.0",
    "@ionic/vue-router": "^9.0.0",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "ionicons": "^8.1.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.0",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.3.0",
    "cypress": "^13.5.0",
    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "jsdom": "^22.1.0",
    "openapi-typescript": "^7.13.0",
    "terser": "^5.16.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "~4.0.18",
    "vue-tsc": "^2.1.10"
  },
  "description": "HealthLab LIMS — cliente web y móvil (Ionic + Vue + Capacitor)"
}
